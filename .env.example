# Choose sqlite for the standalone sample or sqlserver for a configured database.
YATRAFLOW_DB_ENGINE=sqlite
PORT=5173

# Local SQLite path. The SQLite default is explicit development/sample mode.
# YATRAFLOW_SQLITE_PATH=./data/yatraflow.sqlite3
# Optional conservative override: force the sample-data banner on any engine.
# YATRAFLOW_DATA_MODE=demo
# Do not set configured/integrated mode via environment; SQLite is always demo.

# SQL Server settings (set YATRAFLOW_DB_ENGINE=sqlserver before using these).
SQLSERVER_SERVER=localhost,1433
SQLSERVER_DATABASE=YatraFlow
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_USERNAME=
SQLSERVER_PASSWORD=
SQLSERVER_TRUSTED_CONNECTION=false
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_SERVER_CERTIFICATE=no
# Optional raw ODBC connection string instead of the fields above:
# SQLSERVER_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=...;DATABASE=...;UID=...;PWD=...;Encrypt=yes;TrustServerCertificate=no;

# Required for first-time SQL Server account creation; keep secrets in a secret manager.
# YATRAFLOW_BOOTSTRAP_ADMIN_EMAIL=admin@example.org
# YATRAFLOW_BOOTSTRAP_ADMIN_PASSWORD=
# YATRAFLOW_BOOTSTRAP_ADMIN_NAME=Site Administrator
# YATRAFLOW_BOOTSTRAP_ADMIN_ROLE=super_admin
# YATRAFLOW_BOOTSTRAP_SITE_ID=1

# Optional keyed mobile-service ingestion. Never embed this in frontend code.
# YATRAFLOW_MOBILE_API_KEY=

# Set true only behind a trusted HTTPS reverse proxy that forwards X-Forwarded-Proto.
# YATRAFLOW_COOKIE_SECURE=true
